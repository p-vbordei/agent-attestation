{
  "name": "agent-attestation",
  "version": "2026.5.24",
  "description": "Cryptographically verifiable receipts for AI agent actions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "attest": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "agent",
    "ai",
    "attestation",
    "receipts",
    "signing",
    "audit",
    "compliance"
  ],
  "author": "Vlad Bordei <bordeivlad@gmail.com> (https://github.com/p-vbordei)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "sigstore": "^5.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
